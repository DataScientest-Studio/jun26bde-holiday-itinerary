# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# environment
.env
.env.*
!.env.example

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
venv/
*.egg-info/
.installed.cfg
*.egg

# Jupyter
.ipynb_checkpoints/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Test / cache files
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs
*.log
logs/
airflow_logs/

# Airflow local/generated files
airflow.db
airflow.cfg
airflow-webserver.pid
simple_auth_manager_passwords.json.generated


*.db
*.sqlite
*.sqlite3
*.rdb

# Docker local overrides
docker-compose.override.yml
compose.override.yml

# IDEs
.vscode/
.idea/

# macOS
.DS_Store

# Temporary files
*.tmp
*.swp
*.swo
tmp/
temp/

